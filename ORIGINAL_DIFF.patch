+      'Slotted caption'
+    );
+  });
+
+  it('does not render an empty caption container', async () => {
+    const el = await fixture(html`
+      <cds-toast-notification></cds-toast-notification>
+    `);
+
+    expect(
+      el.shadowRoot?.querySelector(`.${prefix}--toast-notification__caption`)
+    ).to.not.exist;
+  });
